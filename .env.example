# Скопируйте этот файл в .env и вставьте свои ключи.
# Файл .env в GitHub не загружается.

# Ключ бесплатного тарифа GNews. Вставляется сразу после знака =, без кавычек.
# Пример вида строки: GNEWS_API_KEY=abc123
GNEWS_API_KEY=

# Ключ языковой модели с курса. ProxyAPI или GenAPI — достаточно одного.
# ProxyAPI:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini

# Если используете GenAPI, замените две строки выше на:
# OPENAI_BASE_URL=https://proxy.gen-api.ru/v1
# OPENAI_MODEL=gpt-4o-mini

# Температура ИИ-операции. 0.2 — ответы ближе к схеме, меньше выдумок.
LLM_TEMPERATURE=0.2

# Файл базы SQLite. Папка data создаётся сама.
DATABASE_PATH=data/scout.db
